# Copy this file to .env to override defaults. All variables are optional.

# Where notes and recordings are stored.
# Setting this PINS the location: the Settings tab will show it as
# environment-controlled instead of letting you move it from the UI.
# Leave it unset to choose (and change) the folder in Settings instead —
# including a OneDrive / Google Drive / Dropbox folder for cloud sync.
# ECHOPAD_STORAGE_DIR=./notes

# Where app preferences and the search index live (per machine, never synced).
# ECHOPAD_CONFIG_DIR=~/.echopad

# Default model selections (still changeable per-session in the sidebar,
# or savable as defaults from the Settings tab)
ECHOPAD_WHISPER_MODEL=base
ECHOPAD_OLLAMA_MODEL=llama3.2
